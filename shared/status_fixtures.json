{
  "_comment": "Shared by backend/tests/test_receipts.py and frontend/lib/status.test.ts. Eligible recipients: user_id != sender AND joined_seq < seq AND (left_seq IS NULL OR seq <= left_seq). read = min(read cursor) >= seq; delivered = min(delivered cursor) >= seq.",
  "cases": [
    {"name": "only the sender is a member -> sent", "seq": 5, "sender_id": "a",
     "members": [{"user_id": "a", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 5, "last_read_seq": 5}],
     "expected": "sent"},
    {"name": "dm: recipient has not acked -> sent", "seq": 3, "sender_id": "a",
     "members": [{"user_id": "a", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 3, "last_read_seq": 3},
                 {"user_id": "b", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 2, "last_read_seq": 0}],
     "expected": "sent"},
    {"name": "dm: delivered but not read", "seq": 3, "sender_id": "a",
     "members": [{"user_id": "a", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 3, "last_read_seq": 3},
                 {"user_id": "b", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 3, "last_read_seq": 1}],
     "expected": "delivered"},
    {"name": "dm: read", "seq": 3, "sender_id": "a",
     "members": [{"user_id": "a", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 3, "last_read_seq": 3},
                 {"user_id": "b", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 4, "last_read_seq": 4}],
     "expected": "read"},
    {"name": "group: one lagging reader keeps it delivered", "seq": 5, "sender_id": "a",
     "members": [{"user_id": "a", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 5, "last_read_seq": 5},
                 {"user_id": "b", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 5, "last_read_seq": 5},
                 {"user_id": "c", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 5, "last_read_seq": 2}],
     "expected": "delivered"},
    {"name": "group: everyone read", "seq": 5, "sender_id": "a",
     "members": [{"user_id": "a", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 5, "last_read_seq": 5},
                 {"user_id": "b", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 6, "last_read_seq": 6},
                 {"user_id": "c", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 5, "last_read_seq": 5}],
     "expected": "read"},
    {"name": "a late joiner is not a recipient of older messages", "seq": 4, "sender_id": "a",
     "members": [{"user_id": "a", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 4, "last_read_seq": 4},
                 {"user_id": "b", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 4, "last_read_seq": 4},
                 {"user_id": "c", "joined_seq": 4, "left_seq": null, "last_delivered_seq": 4, "last_read_seq": 4}],
     "expected": "read"},
    {"name": "late joiner IS a recipient of messages after joining", "seq": 5, "sender_id": "a",
     "members": [{"user_id": "a", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 5, "last_read_seq": 5},
                 {"user_id": "b", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 5, "last_read_seq": 5},
                 {"user_id": "c", "joined_seq": 4, "left_seq": null, "last_delivered_seq": 5, "last_read_seq": 0}],
     "expected": "delivered"},
    {"name": "a removed member is not expected to ack later messages", "seq": 8, "sender_id": "a",
     "members": [{"user_id": "a", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 8, "last_read_seq": 8},
                 {"user_id": "b", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 8, "last_read_seq": 8},
                 {"user_id": "c", "joined_seq": 0, "left_seq": 5, "last_delivered_seq": 5, "last_read_seq": 5}],
     "expected": "read"},
    {"name": "a removed member still counts for messages from before the removal", "seq": 4, "sender_id": "a",
     "members": [{"user_id": "a", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 4, "last_read_seq": 4},
                 {"user_id": "b", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 4, "last_read_seq": 4},
                 {"user_id": "c", "joined_seq": 0, "left_seq": 5, "last_delivered_seq": 2, "last_read_seq": 2}],
     "expected": "sent"},
    {"name": "boundary: seq equal to left_seq is still eligible", "seq": 5, "sender_id": "a",
     "members": [{"user_id": "a", "joined_seq": 0, "left_seq": null, "last_delivered_seq": 5, "last_read_seq": 5},
                 {"user_id": "c", "joined_seq": 0, "left_seq": 5, "last_delivered_seq": 5, "last_read_seq": 3}],
     "expected": "delivered"}
  ]
}
